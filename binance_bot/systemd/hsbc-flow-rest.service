[Unit]
Description=HSBC bot flow REST collector (P6.1 + P6.2 + P6.4) — poll Binance flux Futures
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ludov/HSBC-algo-genetic/binance_bot
ExecStart=/home/ludov/HSBC-algo-genetic/binance_bot/systemd/hsbc-bot-runner.sh routines.flow_rest_collector
StandardOutput=append:/home/ludov/HSBC-algo-genetic/binance_bot/logs/flow_rest.log
StandardError=append:/home/ludov/HSBC-algo-genetic/binance_bot/logs/flow_rest.log
TimeoutStartSec=120

[Install]
WantedBy=default.target
